{"voice":"fr_FR-siwis-medium","count":134,"version":1,"targets":{"s'adapter à quelque chose":[{"id":"a2a0c0f31918b890e3d2","offset":0}],"Les nouveaux arrivants doivent s'adapter à un nouvel environnement.":[{"id":"946fe4f577a6f450219e","offset":0}],"s'inscrire à quelque chose":[{"id":"ced82d08cf2249f88663","offset":0}],"Comment puis-je m'inscrire à cette activité ?":[{"id":"663dee8f97ba8015e85d","offset":0}],"s'intégrer dans quelque chose":[{"id":"632125d5316b2be1a987","offset":0}],"Il faut du temps pour s'intégrer dans une nouvelle société.":[{"id":"82dfb0847c10d08c7917","offset":0}],"se renseigner sur quelque chose":[{"id":"5d7a8e938b2750ba34d8","offset":0}],"Je voudrais me renseigner sur les tarifs.":[{"id":"1ffb1896b8299c8fc727","offset":0}],"se rendre à un lieu":[{"id":"df60bc39262fe68996b8","offset":0}],"Comment peut-on se rendre au centre-ville ?":[{"id":"951660ea656b49b2d76b","offset":0}],"se sentir à l'aise":[{"id":"3ddca9c08d194478e3bf","offset":0}],"Les jeunes doivent pouvoir se sentir à l'aise à l'école.":[{"id":"3eaf550e8995c8fdbab2","offset":0}],"se concentrer sur quelque chose":[{"id":"b423074f38f5c04194ab","offset":0}],"Les étudiants doivent se concentrer sur leurs études.":[{"id":"7ae67ffb6cd419eecb5e","offset":0}],"s'intéresser à quelque chose":[{"id":"ce946679f5f4b81557c4","offset":0}],"De plus en plus de jeunes s'intéressent à l'écologie.":[{"id":"bce185a558fe9245e599","offset":0}],"s'occuper de quelqu'un":[{"id":"8de29f967139d892dcc6","offset":0}],"Les parents doivent s'occuper de leurs enfants.":[{"id":"3800a6ca2a4e47402157","offset":0}],"se souvenir de quelque chose":[{"id":"ed52b2e4e64dddf30369","offset":0}],"Je me souviens de ma première expérience à l'étranger.":[{"id":"2e17835a9cbfb41e17c6","offset":0}],"se rendre compte de quelque chose":[{"id":"c8e436e6aa0ff32d2ad6","offset":0}],"Beaucoup de jeunes se rendent compte de l'importance des langues.":[{"id":"38daa60b6ddd3a46b112","offset":0}],"s'habituer à quelque chose":[{"id":"23c8a2c0d0e7525d7155","offset":0}],"Il faut du temps pour s'habituer à un autre mode de vie.":[{"id":"e5751d2ff2af0601b640","offset":0}],"se préparer à quelque chose":[{"id":"dca2d7faaa34e263fa3f","offset":0}],"Les candidats se préparent à leur examen de français.":[{"id":"4e4dff4d2c911a5d1adc","offset":0}],"se demander si cette activité est possible":[{"id":"d02e89ace8fc0ed46e26","offset":0}],"Je me demande si cette activité est adaptée aux débutants.":[{"id":"14be7ef94bd1db7f899b","offset":0}],"se développer":[{"id":"42fdd206fb557529fc37","offset":0}],"Les compétences linguistiques se développent avec la pratique.":[{"id":"cfbf9fa45567e32650cc","offset":0}],"se retrouver":[{"id":"147238563762a1916abb","offset":0}],"Les familles peuvent se retrouver le week-end.":[{"id":"a6357043ffeadc608525","offset":0}],"s'entraider":[{"id":"cb34948acad3d803a735","offset":0}],"Les étudiants peuvent s'entraider pendant leur formation.":[{"id":"56bcb2d6af7186fb72eb","offset":0}],"se rencontrer":[{"id":"3c368cdd0a26d05716db","offset":0}],"Les habitants se rencontrent lors des activités du quartier.":[{"id":"ec50ce1b66b9bd64ebb4","offset":0}],"se connaître":[{"id":"9fd89a640e6b1205a135","offset":0}],"Les élèves apprennent à se connaître grâce aux projets collectifs.":[{"id":"c9e560d88d98003551d8","offset":0}],"se déplacer en bus":[{"id":"0f61572149318bbb7081","offset":0}],"Peut-on se déplacer en bus dans cette ville ?":[{"id":"e4b163d6d6c01f82e1f4","offset":0}],"se familiariser avec quelque chose":[{"id":"5f6e6c991b40dce12d86","offset":0}],"Les immigrants doivent se familiariser avec les règles locales.":[{"id":"a42cbe380e76862e17a5","offset":0}],"s'engager dans quelque chose":[{"id":"c27e02d7bfccc98740eb","offset":0}],"Les jeunes peuvent s'engager dans des projets associatifs.":[{"id":"aebb0728e7ee975312a2","offset":0}],"s'investir dans quelque chose":[{"id":"548525317ae5363892fe","offset":0}],"Les parents devraient s'investir dans l'éducation de leurs enfants.":[{"id":"e56d19623fac3d2e7908","offset":0}],"se comparer à quelqu'un":[{"id":"8cd24ed33964712d7854","offset":0}],"Certains jeunes se comparent constamment à leurs camarades.":[{"id":"ec16eb55b3ea0d3dda75","offset":0}],"se passer de quelque chose":[{"id":"ec3654a90c688742e386","offset":0}],"Il est difficile de se passer d'Internet aujourd'hui.":[{"id":"8ac7c9d02ebcf653186b","offset":0}],"se servir de quelque chose":[{"id":"3a5774aabe11fa5413c5","offset":0}],"On peut se servir des outils numériques pour apprendre.":[{"id":"b9e62c7dad6516736f97","offset":0}],"se méfier de quelque chose":[{"id":"7788b1ddcd2a66ca7322","offset":0}],"Il faut se méfier des fausses informations en ligne.":[{"id":"77b9405d6c63b1aca881","offset":0}],"se fier à quelqu'un":[{"id":"90ee0657ce41b63f6a37","offset":0}],"Les consommateurs peuvent se fier aux avis vérifiés.":[{"id":"f5efc160d0a55eeae2c3","offset":0}],"se battre pour quelque chose":[{"id":"1788bb1456f82dac546d","offset":0}],"Certaines associations se battent pour l'égalité des chances.":[{"id":"01fe116e07992a897808","offset":0}],"se protéger contre quelque chose":[{"id":"0d3a5fc40984734c1fff","offset":0}],"Il faut se protéger contre les risques liés à Internet.":[{"id":"1893f7fe62f9534a9a09","offset":0}],"s'améliorer":[{"id":"088af8a414f868b5d70a","offset":0}],"Le niveau de français s'améliore avec la pratique régulière.":[{"id":"df747160b8df2601a037","offset":0}],"s'épanouir":[{"id":"9c1ae5dbc024f4cd0e0e","offset":0}],"Les enfants ont besoin de temps libre pour s'épanouir.":[{"id":"ddbf4b47f99a162518cb","offset":0}],"se reconvertir dans quelque chose":[{"id":"cc551f081671e7af3547","offset":0}],"Certains salariés choisissent de se reconvertir dans l'informatique.":[{"id":"4049d960e1e04365cb82","offset":0}],"se lancer dans quelque chose":[{"id":"9835472e3d9030bdf1ba","offset":0}],"De nombreux jeunes hésitent à se lancer dans l'entrepreneuriat.":[{"id":"66f7553c2c6a6afe37fc","offset":0}],"se joindre à quelqu'un":[{"id":"ede4e5d45f0d01b1839f","offset":0}],"Puis-je me joindre à votre groupe ?":[{"id":"1a3ce45ec3b46d8242cb","offset":0}],"se réunir":[{"id":"839a0e88b0cecb965f33","offset":0}],"Les habitants se réunissent pour discuter du projet.":[{"id":"7cf8789464a4cf307fbb","offset":0}],"s'entendre avec quelqu'un":[{"id":"5230c2c075461ee51bda","offset":0}],"Il est important de bien s'entendre avec ses collègues.":[{"id":"fc0296e9921a0fbc034f","offset":0}],"se disputer avec quelqu'un":[{"id":"26219c638cccd45465db","offset":0}],"Les enfants peuvent parfois se disputer avec leurs camarades.":[{"id":"27933714374a6f7835cf","offset":0}],"se présenter":[{"id":"b62dc19371ffd9f89da8","offset":0}],"Dois-je me présenter à l'accueil avant le cours ?":[{"id":"e4e13024edd76f1f4ef2","offset":0}],"se détendre":[{"id":"52b9404b6a735d8c9ff1","offset":0}],"Faire du sport permet de se détendre après le travail.":[{"id":"b4b169caa99a635b2afa","offset":0}],"se consacrer à quelque chose":[{"id":"313a8e23f9ccd78a8bc7","offset":0}],"Les bénévoles se consacrent à l'aide aux personnes âgées.":[{"id":"f5f4969a865028942cc4","offset":0}],"se préoccuper de quelque chose":[{"id":"fcc16c7d142682be865f","offset":0}],"Les citoyens se préoccupent de plus en plus de l'environnement.":[{"id":"76b8579cedd702e2bb04","offset":0}],"s'interroger sur quelque chose":[{"id":"76724f445027bae506ed","offset":0}],"Il faut s'interroger sur les effets des réseaux sociaux.":[{"id":"c7f8c6ab67827edfd262","offset":0}],"se mobiliser pour quelque chose":[{"id":"9e8071f72d31a4765159","offset":0}],"Les habitants se mobilisent pour protéger leur quartier.":[{"id":"f5fcc39c2d4f6b899d07","offset":0}],"se heurter à quelque chose":[{"id":"599d5311f6bc6aa28e39","offset":0}],"Les nouveaux arrivants se heurtent parfois à des obstacles administratifs.":[{"id":"238bf20cfbe40f6c5de7","offset":0}],"se traduire par quelque chose":[{"id":"7b0c35dd2b41575d273d","offset":0}],"Cette politique se traduit par une réduction des coûts.":[{"id":"1e601c310dd2daaec1e5","offset":0}],"se distinguer de quelque chose":[{"id":"6d782d40760fe3cd99af","offset":0}],"Ce système se distingue de celui des autres pays.":[{"id":"2c660a50cf9d68596d67","offset":0}],"se remettre en question":[{"id":"048616ba3aa8878f2d27","offset":0}],"Les employés doivent parfois se remettre en question pour progresser.":[{"id":"5a92f45568d64ad4c983","offset":0}],"se rendre utile":[{"id":"152bf8385139e340107f","offset":0}],"Le bénévolat permet aux jeunes de se rendre utiles.":[{"id":"b1850d963bb76cb54032","offset":0}],"se fixer un objectif":[{"id":"abb7203458937dfc8582","offset":0}],"Pour réussir, il vaut mieux se fixer un objectif réaliste.":[{"id":"2502a6e8daa4097ee8b6","offset":0}],"Je me suis inscrite à ce cours.":[{"id":"a7d54e50d4b0301c89fb","offset":0}],"Elle s'est bien intégrée dans sa nouvelle équipe.":[{"id":"3ae7f8ffe26eda67f75f","offset":0}],"Je me suis rendue au centre culturel hier.":[{"id":"214883d38fa055122714","offset":0}],"Je me suis sentie à l'aise pendant l'entretien.":[{"id":"6782c71a4649f14760ec","offset":0}],"Je me suis souvenue de cette expérience.":[{"id":"84df6396bf42e4e64013","offset":0}],"Je me suis rendu compte que ce cours était utile.":[{"id":"71ecfc0ab3d53c02f1e7","offset":0}],"Je me suis habituée à ce nouvel environnement.":[{"id":"2dcf3d7591a90e836364","offset":0}],"Je me suis préparée à cet examen.":[{"id":"0fca8c7ba9e9e2f544b8","offset":0}],"Nous nous sommes retrouvés après la formation.":[{"id":"0238056eb1788811448d","offset":0}],"On s'est rencontrés lors d'une activité culturelle.":[{"id":"5a44c21371d8c5e31439","offset":0}],"Nous nous sommes connus pendant nos études.":[{"id":"4cb4fb9ba6aed7df068c","offset":0}],"Mon niveau de français s'est amélioré.":[{"id":"078c9de3df71025362b0","offset":0}],"Elle s'est reconvertie dans l'informatique.":[{"id":"2d1a61bfdc1be5d8daa0","offset":0}],"Elle s'est lancée dans un nouveau projet.":[{"id":"5cca511c0c7862acbee7","offset":0}],"Je me suis jointe au groupe de bénévoles.":[{"id":"f5e5f296c060f0987c77","offset":0}],"Ils se sont disputés à propos du projet.":[{"id":"c5b6800cee98cb0bc878","offset":0}],"Je me suis présentée à l'accueil avant le cours.":[{"id":"2b43ed8b48ee05633e49","offset":0}],"Elle s'est remise en question après cet échec.":[{"id":"b5fdf65da099e6c292a3","offset":0}],"Je ne me suis pas encore inscrite à cette formation.":[{"id":"4d0b6b72be8e8e9fef8e","offset":0}],"Certains nouveaux arrivants ne s'intègrent pas facilement.":[{"id":"1bdd9e51678b6c8f99cd","offset":0}],"Je ne me suis pas encore renseignée sur les tarifs.":[{"id":"10bb5d202bfa47f8687a","offset":0}],"Je ne me sens pas encore à l'aise pour parler français.":[{"id":"9c524542608faa10441b","offset":0}],"Les élèves ne se concentrent pas suffisamment pendant le cours.":[{"id":"c6c2efd978bcd86854f8","offset":0}],"Certains jeunes ne s'intéressent pas suffisamment à la politique.":[{"id":"cd858fd088c4ad57e0b4","offset":0}],"Je ne me souviens plus du nom de l'organisateur.":[{"id":"2c2ab1ea8d416aa3ede2","offset":0}],"Ils ne se rendent pas compte des difficultés des nouveaux arrivants.":[{"id":"cf3556a897d44a6965b1","offset":0}],"Certaines personnes ne s'habituent pas facilement à la vie à l'étranger.":[{"id":"dde2c97b74467a40ca87","offset":0}],"Je ne me demande pas si ce cours est intéressant, mais s'il convient à mon niveau.":[{"id":"b9f35bda3f08944a3910","offset":0}],"Sans échanges réguliers, les habitants ne s'entraident pas suffisamment.":[{"id":"aebebbf18f5dbd7103ab","offset":0}],"Aujourd'hui, on ne peut plus se passer d'Internet.":[{"id":"9581ca1d8c4f4da34496","offset":0}],"Certains consommateurs ne se méfient pas des fausses publicités.":[{"id":"eebeb2f908ce9017de2f","offset":0}],"Il ne faut pas se fier à toutes les informations sur Internet.":[{"id":"5834ac29b5f8c0555fcb","offset":0}],"Certains collègues ne s'entendent pas très bien.":[{"id":"e6254dd18343e88ec06d","offset":0}],"Je ne me suis pas présentée à l'accueil hier.":[{"id":"c4125c4e3ce4eba7fea1","offset":0}]},"records":{"a2a0c0f31918b890e3d2":{"id":"a2a0c0f31918b890